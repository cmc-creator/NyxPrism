{
  "name": "NyxPrism PDF Tools",
  "short_name": "NyxPrism",
  "id": "/dashboard.html",
  "description": "Professional PDF tools — split, merge, compress, OCR, watermark and more.",
  "start_url": "/dashboard.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#06080d",
  "theme_color": "#7c3aed",
  "orientation": "any",
  "icons": [
    {
      "src": "/prismlogo.jpg?v=1",
      "sizes": "any",
      "type": "image/jpeg",
      "purpose": "any maskable"
    },
    {
      "src": "/prismlogo.jpg?v=1",
      "sizes": "any",
      "type": "image/jpeg",
      "purpose": "any maskable"
    },
    {
      "src": "/prismlogo.jpg?v=1",
      "sizes": "any",
      "type": "image/jpeg",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/dashboard.html?source=file-handler",
      "accept": {
        "application/pdf": [".pdf"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "categories": ["productivity", "utilities"],
  "lang": "en-US"
}
