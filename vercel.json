{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "docs",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nyxprism-production.up.railway.app/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/distribution",
      "destination": "/distribution.html"
    },
    {
      "source": "/sign-request",
      "destination": "/sign-request.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/add-page-numbers-pdf",
      "destination": "/add-page-numbers-pdf.html"
    },
    {
      "source": "/ai-pdf-splitter",
      "destination": "/ai-pdf-splitter.html"
    },
    {
      "source": "/annotate-pdf",
      "destination": "/annotate-pdf.html"
    },
    {
      "source": "/batch-compress-pdf",
      "destination": "/batch-compress-pdf.html"
    },
    {
      "source": "/compare-pdf",
      "destination": "/compare-pdf.html"
    },
    {
      "source": "/compress-pdf",
      "destination": "/compress-pdf.html"
    },
    {
      "source": "/edit-pdf",
      "destination": "/edit-pdf.html"
    },
    {
      "source": "/edit-pdf-metadata",
      "destination": "/edit-pdf-metadata.html"
    },
    {
      "source": "/extract-pdf-text",
      "destination": "/extract-pdf-text.html"
    },
    {
      "source": "/flatten-pdf",
      "destination": "/flatten-pdf.html"
    },
    {
      "source": "/merge-pdf",
      "destination": "/merge-pdf.html"
    },
    {
      "source": "/ocr-pdf",
      "destination": "/ocr-pdf.html"
    },
    {
      "source": "/organize-pdf-pages",
      "destination": "/organize-pdf-pages.html"
    },
    {
      "source": "/pdf-header-footer",
      "destination": "/pdf-header-footer.html"
    },
    {
      "source": "/pdf-to-image",
      "destination": "/pdf-to-image.html"
    },
    {
      "source": "/protect-pdf",
      "destination": "/protect-pdf.html"
    },
    {
      "source": "/redact-pdf",
      "destination": "/redact-pdf.html"
    },
    {
      "source": "/request-signatures",
      "destination": "/request-signatures.html"
    },
    {
      "source": "/rotate-pdf",
      "destination": "/rotate-pdf.html"
    },
    {
      "source": "/send-pdf",
      "destination": "/send-pdf.html"
    },
    {
      "source": "/sign-pdf",
      "destination": "/sign-pdf.html"
    },
    {
      "source": "/split-pdf",
      "destination": "/split-pdf.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/watermark-pdf",
      "destination": "/watermark-pdf.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://browser.sentry-cdn.com https://apis.google.com https://accounts.google.com https://www.dropbox.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://nyxprism-production.up.railway.app; connect-src 'self' blob: https://nyxprism-production.up.railway.app https://*.ingest.us.sentry.io https://*.dropboxusercontent.com https://accounts.google.com https://www.gstatic.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://tessdata.projectnaptha.com; worker-src 'self' blob: https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; frame-src https://docs.google.com https://accounts.google.com https://content.googleapis.com https://www.dropbox.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(sign-request|distribution|sign-request\\.html|distribution\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|jpg|jpeg|ico|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
