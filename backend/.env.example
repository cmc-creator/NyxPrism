# ── PostgreSQL — Railway provides DATABASE_URL automatically ──────────
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway
# Railway private endpoints (*.railway.internal) use the isolated private network.
# Public production database endpoints use verified TLS unless explicitly disabled.
DATABASE_SSL=false
# Optional PEM CA certificate when the database certificate is not publicly trusted.
DATABASE_SSL_CA=

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# ── Brevo (email delivery) ────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
CONTACT_EMAIL=info@nyxprism.com

# ── Firebase Admin SDK ────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON → copy values below.
# Keep the key on one line with escaped newlines, as Firebase provides it in JSON.
FIREBASE_PROJECT_ID=nyxprism-2a817
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nyxprism-2a817.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="paste_the_escaped_private_key_here"

# ── Anthropic (Claude) — AI Split feature ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://nyxprism.com
PORT=3000
NODE_ENV=production

# AI requests allowed per user per day (owner/reviewer accounts are unlimited)
AI_DAILY_LIMIT=100

# Comma-separated Firebase emails that receive developer access without a trial
DEVELOPER_EMAILS=developer@example.com

# Error monitoring (sentry.io → project settings → Client Keys). Leave empty to disable.
SENTRY_DSN=
